
/**
 * Implements the maze and wall collision detection.
 * The screen is divided into 32 columns and 16 rows.
 * Each cell measures 16 by 16 pixels.
 *
 * Map values:
 * 0 = free corridor
 * 1 = wall
 */
class Maze {

    field Array map;

    /** Creates and initializes the maze. */
    constructor Maze new() {
        var int row;
        var int col;
        var int index;
        var String line;

        let map = Array.new(512);

        let index = 0;
        let row = 0;

        while (row < 16) {
            let line = layoutRow(row);
            let col = 0;

            while (col < 32) {
                if (line.charAt(col) = 49) {
                    let map[index] = 1;
                } else {
                    let map[index] = 0;
                }

                let col = col + 1;
                let index = index + 1;
            }

            let row = row + 1;
        }

        return this;
    }

    method String layoutRow(int row) {
        if (row = 0)  { return "11111111111111111111111111111111"; }
        if (row = 1)  { return "10000100100000001000000000000011"; }
        if (row = 2)  { return "10110101101011101010101111100101"; }
        if (row = 3)  { return "11100000101010101010101010001001"; }
        if (row = 4)  { return "10001110001010101010101010010001"; }
        if (row = 5)  { return "10001000001010101010101010100101"; }
        if (row = 6)  { return "11111111101010101010101010001001"; }
        if (row = 7)  { return "10000000001010101010101011011011"; }
        if (row = 8)  { return "10000000001010101010101011011011"; }
        if (row = 9)  { return "10111111111010101010101010001001"; }
        if (row = 10) { return "10000010001010101010101010100101"; }
        if (row = 11) { return "10001110001010101010101010010001"; }
        if (row = 12) { return "11100000101010101010101010001001"; }
        if (row = 13) { return "10110101101110101010111011100101"; }
        if (row = 14) { return "10000100100000000010000000000011"; }

        return "11111111111111111111111111111111";
    }

    /**
     * Returns true if the pixel position
     * corresponds to a wall or is outside the screen.
     */
    method boolean isWall(int pixelX, int pixelY) {
        var int row;
        var int col;
        var int index;

        // Protects the screen boundaries.
        if ((pixelX < 0) | (pixelX > 496) |
            (pixelY < 0) | (pixelY > 240)) {
            return true;
        }

        let col = pixelX / 16;
        let row = pixelY / 16;

        let index = row + row;
        let index = index + index;
        let index = index + index;
        let index = index + index;
        let index = index + index;

        let index = index + col;

        if (map[index] = 1) {
            return true;
        }

        return false;
    }


    method void draw() {
        var int row;
        var int col;
        var int address;
        var int rowBase;
        var int mapIndex;
        var int endAddress;

        do Screen.clearScreen();

        let row = 0;
        let rowBase = 0;
        let mapIndex = 0;

        while (row < 16) {
            let col = 0;

            while (col < 32) {

                if (map[mapIndex] = 1) {
                    // Endereço inicial da parede.
                    let address = 16384 + rowBase + col;
                    let endAddress = address + 512;

                    // Uma palavra de 16 bits por linha.
                    while (address < endAddress) {
                        do Memory.poke(address, -1);

                        // Próxima linha da tela.
                        let address = address + 32;
                    }
                }

                let col = col + 1;
                let mapIndex = mapIndex + 1;
            }

            let row = row + 1;
            let rowBase = rowBase + 512;
        }

        return;
    }


    /** Releases the map array and this object. */
    method void dispose() {
        do map.dispose();
        do Memory.deAlloc(this);
        return;
    }
}
