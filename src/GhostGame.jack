/**
 * Implements the Ghost Multiplayer game.
 * This game features two players: a Ghost and a Person.
 * The Ghost player attempts to catch the Person player,
 * who must escape before the countdown reaches zero.
 *
 * The Ghost player uses the arrow keys to control the
 * Ghost's direction: Up, Down, Left, and Right.
 *
 * The Person player uses the WASD keys:
 * W = Up, S = Down, A = Left, D = Right.
 */

class GhostGame {
   field int directionGhost;
   field int directionPerson;
   field Random random;
   field Ghost ghost;
   field Person person;
   field Maze maze;
   field int cycles;
   field int seconds;

   /** Constructs a new Ghost_Multiplayer Game. */
   constructor GhostGame new() {
      var int ghostPositionX;
      var int ghostPositionY;
      var int personPositionX;
      var int personPositionY;
      var int dx;
      var int dy;
      var int minDis;
      var boolean validGhostPosition;
      var boolean validPersonPosition;

      let maze = Maze.new();
      do maze.draw();
      do waitForStart();

      /* Generating the position of the two characters of the game: */

      let validGhostPosition = false;
      let validPersonPosition = false;

      while (~validGhostPosition) {
         let ghostPositionX = random.randRange(31) * 16;
         let ghostPositionY = random.randRange(15) * 16;

         if (~(Memory.peek(16384 + (32 * ghostPositionY) + (ghostPositionX / 16)) = -1)) {
            let validGhostPosition = true;
         }
      }

      while (~validPersonPosition) {
         let personPositionX = random.randRange(31) * 16;
         let personPositionY = random.randRange(15) * 16;

         if (~(Memory.peek(16384 + (32 * personPositionY) + (personPositionX / 16)) = -1)) {
            let dx = (personPositionX - ghostPositionX) / 2;
            let dy = (personPositionY - ghostPositionY) / 2;
            let minDis = 18;

            if (((dx * dx) + (dy * dy)) > minDis) {
               let validPersonPosition = true;
            }
         }
      }

      let ghost = Ghost.new(ghostPositionX, ghostPositionY);
      let person = Person.new(personPositionX, personPositionY);

      let directionGhost = 0;
      let directionPerson = 0;
      let cycles = 0;
      let seconds = 0;

      return this;
   }

   /** Disposes this game and its objects. */
   method void dispose() {
      do ghost.dispose();
      do person.dispose();
      do maze.dispose();
      do random.dispose();

      do Memory.deAlloc(this);

   return;
   }

   /** Moves the Ghost in the current direction. */
   method void moveGhost() {
      if (directionGhost = 1) {
         do ghost.moveUp(maze);
      }

      if (directionGhost = 2) {
         do ghost.moveDown(maze);
      }

      if (directionGhost = 3) {
         do ghost.moveLeft(maze);
      }

      if (directionGhost = 4) {
         do ghost.moveRight(maze);
      }

      return;
   }

   /** Moves the Person in the current direction. */
   method void movePerson() {
      if (directionPerson = 5) {
         do person.moveUp(maze);
      }

      if (directionPerson = 6) {
         do person.moveDown(maze);
      }

      if (directionPerson = 7) {
         do person.moveLeft(maze);
      }

      if (directionPerson = 8) {
         do person.moveRight(maze);
      }

      return;
   }

   /** Checks whether the Ghost caught the Person. */
   method boolean playersCollision() {
      if ((ghost.getX() = person.getX()) &
      (ghost.getY() = person.getY())) {
      return true;
      }
    return false;
   }

   method void waitForStart() {
      var char key;
      var int i;
      var int counter;

      do Output.moveCursor(15, 3);
      do Output.printString("Pressione qualquer tecla para iniciar o jogo");

      let key = 0;
      let counter = 0;
      while (key = 0) {
         let counter = counter + 1;
         let key = Keyboard.keyPressed();
      }

      let random = Random.new(counter);

      do Output.moveCursor(15, 3);
      let i = 0;
      while (i < 44) {
         do Output.printChar(32);
         let i = i + 1;
      }
      return;
   }

    method boolean updateTimer() {
      var int delay;
      let delay = 0;
      while (delay < 5645) {
         let delay = delay + 1;
      }
      let cycles = cycles + 1;
      if (cycles = 15) {
         let seconds = seconds + 1;
         let cycles = 0;
      }
      if (seconds = 63) {
         return true;
      }
      return false;
   }

    /** Shows the winner and clears the playing field. */
   method boolean showEndScreen(int winner) {
      var int ticks;
      var int delay;
      var char key;
      var boolean escArmed;

      let ticks = 0;
      let escArmed = false;

      do Screen.clearScreen();
      do Output.moveCursor(9, 9);

      if (winner = 1) {
         do Output.printString("Ghost venceu!");
      } else {
         if (winner = 2) {
            do Output.printString("Person venceu!");
         } else {
            do Output.printString("Fim de jogo");
         }
      }

      while (ticks < 150) {
         let delay = 0;
         while (delay < 5645) {
            let delay = delay + 1;
         }
         let key = Keyboard.keyPressed();
         if (~(key = 140)) {
            let escArmed = true;
         } else {
            if (escArmed) {
               return false;
            }
         }
         let ticks = ticks + 1;
      }
      return true;
   }

   /** Runs the game and handles both players' inputs. */
   method boolean run() {
      var char key;
      var boolean exit;
      var int advantageTimer;
      var int winner;

      let exit = false;
      let advantageTimer = 45;
      let winner = 0;

      while (~exit) {
         // Displays timer in seconds
         do Output.moveCursor(0, 0);
         do Output.printInt(seconds);

         // Reads the currently pressed key
         let key = Keyboard.keyPressed();

         // Stops the game
         if (key = 140)  { let exit = true; } // Esc key

         // Ghost movements
         if (key = 131) { let directionGhost = 1; } // up arrow
         if (key = 133) { let directionGhost = 2; } // down arrow
         if (key = 130) { let directionGhost = 3; } // left arrow
         if (key = 132) { let directionGhost = 4; } // right arrow

         // Person movements
         if ((key = 87) | (key = 119)) { let directionPerson = 5; } // W
         if ((key = 83) | (key = 115)) { let directionPerson = 6; } // S
         if ((key = 65) | (key = 97)) { let directionPerson = 7; } // A
         if ((key = 68) | (key = 100)) { let directionPerson = 8; } // D

         // Stops all characters' directions
         if (key = 80) { let directionGhost = 0; let directionPerson = 0; } // P key

         do movePerson();

         // Ghost remains frozen during the initial advantage
         if (advantageTimer > 0) {
            let advantageTimer = advantageTimer - 1;
         } else {
            do moveGhost();

            if (playersCollision()) {
               let exit = true;
               let winner = 1;
            }
         }
         
         if (updateTimer()) {
            let exit = true;
            let winner = 2;
         }
      }

      return showEndScreen(winner);
   }
}