/** Implements a graphical character. */
class Ghost {

   field int x, y;
   field int size;
   field int memAddress;

   /** Constructs a new character with a given location and size. */
   constructor Ghost new(int Ax, int Ay) {
      let x = Ax;
      let y = Ay;
      let size = 16;
      let memAddress = 0;

      do draw();

      return this;
   }

   /** Disposes this character. */
   method void dispose() {
      do Memory.deAlloc(this);
      return;
   }

   /** Draws the character on the screen. */
   method void draw() {
      do drawHappyGhost(y * 32 + (x / size));
      return;
   }

   /** Erases the character from the screen. */
   method void erase() {
      do Screen.setColor(false);
      do Screen.drawRectangle(x, y, x + (size - 1), y + (size - 1));
      return;
   }

   /** Draws the character bitmap. */
   method void drawHappyGhost(int location) {
      let memAddress = 16384+location;

      do Memory.poke(memAddress+0, 8184);
      do Memory.poke(memAddress+32, 16380);
      do Memory.poke(memAddress+64, 25542);
      do Memory.poke(memAddress+96, -1);
      do Memory.poke(memAddress+128, -2065);
      do Memory.poke(memAddress+160, -7225);
      do Memory.poke(memAddress+192, -7225);
      do Memory.poke(memAddress+224, -2065);
      do Memory.poke(memAddress+256, -1);
      do Memory.poke(memAddress+288, -1);
      do Memory.poke(memAddress+320, -1);
      do Memory.poke(memAddress+352, -4081);
      do Memory.poke(memAddress+384, -2017);
      do Memory.poke(memAddress+416, -961);
      do Memory.poke(memAddress+448, -1);
      do Memory.poke(memAddress+480, -1);

      return;
   }

   /** Moves the character up by 16 pixels if the path is free. */
   method void moveUp(Maze maze) {
      if (~(maze.isWall(x, y - 16))) {
        do erase();
        let y = y - 16;
        do draw();
      }
      return;
   }

   /** Moves the character down by 16 pixels if the path is free. */
   method void moveDown(Maze maze) {
      if (~(maze.isWall(x, y + 16))) {
        do erase();
        let y = y + 16;
         do draw();
      }
      return;
   }

   /** Moves the character left by 16 pixels if the path is free. */
   method void moveLeft(Maze maze) {
      if (~(maze.isWall(x - 16, y))) {
        do erase();
        let x = x - 16;
        do draw();
      }
      return;
   }

   /** Moves the character right by 16 pixels if the path is free. */
   method void moveRight(Maze maze) {
      if (~(maze.isWall(x + 16, y))) {
        do erase();
        let x = x + 16;
        do draw();
      }
      return;
   }

   /** Returns the current horizontal position. */
   method int getX() {
      return x;
    }

    /** Returns the current vertical position. */
   method int getY() {
      return y;
    }
}